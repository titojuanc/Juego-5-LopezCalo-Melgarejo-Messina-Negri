[resource]
script = ExtResource("1_npc")
nombre = "Saqueador"
sprite_frames = SubResource("SpriteFrames_robot")
perfil = ExtResource("2_perfil")
lineas_amistoso = Array[String](["Tu fama te precede. Sos de los nuestros.", "Llevate lo que quieras de esta zona, yo no vi nada."])
lineas_indiferente = Array[String](["Este sector lo estamos revisando nosotros.", "Seguí de largo y no pasa nada."])
lineas_hostil = Array[String](["Con esa fama de santito, tenés que llevar cosas buenas encima.", "Dejá todo lo que llevás."])
enemigos = Array[ExtResource("3_enemigo")]([ExtResource("4_enemigo"), ExtResource("4_enemigo")])
reputacion_invertida = true
