[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/menus/fin_demo.gd" id="1"]

[node name="FinDemo" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Fondo" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.07, 0.06, 0.12, 1)

[node name="Centro" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Contenido" type="VBoxContainer" parent="Centro"]
layout_mode = 2
theme_override_constants/separation = 48

[node name="Mensaje" type="Label" parent="Centro/Contenido"]
layout_mode = 2
theme_override_font_sizes/font_size = 40
text = "Fin de la demo.
¡Gracias por jugar!"
horizontal_alignment = 1

[node name="BotonMenu" type="Button" parent="Centro/Contenido"]
custom_minimum_size = Vector2(280, 48)
layout_mode = 2
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 22
text = "Volver al menú principal"

[connection signal="pressed" from="Centro/Contenido/BotonMenu" to="." method="_volver_al_menu"]
